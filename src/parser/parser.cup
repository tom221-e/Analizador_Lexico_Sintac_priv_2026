package parser;
import java_cup.runtime.*;
import java.util.Hashtable;
import java.util.ArrayList;
import ast.*;
import ast.aritmetica.*;
import ast.logica.*;
import ast.relacional.*;
import ast.unario.*;
import ast.read.*;
import ast.literal.*;
// import validator.ValidatorDataType;

class Parser;

action code {:
    Hashtable table = new Hashtable();
    String tam = "0";     // Tamaño del array
    int nivelLoop = 0;    // Controla breaks/continues

    // Estructura auxiliar para retornar los nodos transformados y su tipo resultante
    public class OpResult {
        public Expresion izq;
        public Expresion der;
        public String tipoLLVM;
        public OpResult(Expresion i, Expresion d, String t) {
            this.izq = i; this.der = d; this.tipoLLVM = t;
        }
    }

    // 🌟 HELPER ARITMÉTICO: Resuelve Coerción, Broadcasting y Validación de Arrays
    public OpResult verificarYCoercer(Expresion e1, Expresion e2) {
        String t1 = e1.getTipo(); // Asume que tus nodos retornan "i32", "float", "i1" o "\d+" (dimensión)
        String t2 = e2.getTipo();

        if ("i1".equals(t1) || "i1".equals(t2)) {
            throw new RuntimeException("ERROR SEMÁNTICO: Operación aritmética inválida con tipos BOOLEAN.");
        }

        boolean esArray1 = t1.matches("\\d+");
        boolean esArray2 = t2.matches("\\d+");

        // Caso 1: Ambos son Arrays (FLOAT_ARRAY) -> Deben medir igual
        if (esArray1 && esArray2) {
            if (!t1.equals(t2)) {
                throw new RuntimeException("ERROR SEMÁNTICO: Dimensiones de arreglos incompatibles (" + t1 + " vs " + t2 + ").");
            }
            return new OpResult(e1, e2, t1); // El tipo resultante conserva la dimensión ("10", "50", etc.)
        }

        // Caso 2: Broadcasting (Array operado con Escalar) -> Inserta conversión si el escalar es INT
        if (esArray1) {
            Expresion der = "i32".equals(t2) ? new ConversionFloat(e2) : e2;
            return new OpResult(e1, der, t1);
        }
        if (esArray2) {
            Expresion izq = "i32".equals(t1) ? new ConversionFloat(e1) : e1;
            return new OpResult(izq, e2, t2);
        }

        // Caso 3: Escalares Puros (INT vs FLOAT) -> Coerción estándar
        if ("float".equals(t1) || "double".equals(t1)) {
            Expresion der = "i32".equals(t2) ? new ConversionFloat(e2) : e2;
            return new OpResult(e1, der, "float");
        }
        if ("float".equals(t2) || "double".equals(t2)) {
            Expresion izq = "i32".equals(t1) ? new ConversionFloat(e1) : e1;
            return new OpResult(izq, e2, "float");
        }

        return new OpResult(e1, e2, "i32"); // Ambos son enteros (i32)
    }

    // 🌟 HELPER RELACIONAL: Valida comparaciones entre vectores y escalares
    public OpResult verificarRelacional(Expresion e1, Expresion e2) {
        String t1 = e1.getTipo();
        String t2 = e2.getTipo();

        boolean esArray1 = t1.matches("\\d+");
        boolean esArray2 = t2.matches("\\d+");

        if (esArray1 && esArray2 && !t1.equals(t2)) {
            throw new RuntimeException("ERROR SEMÁNTICO: No se pueden comparar arreglos de distintas dimensiones.");
        }

        String tipoFinal = "int"; // "int" por defecto para tu backend
        Expresion izq = e1;
        Expresion der = e2;

        if ("i32".equals(t1) && ("float".equals(t2) || esArray2)) {
            izq = new ConversionFloat(e1);
            tipoFinal = "float";
        } else if ("i32".equals(t2) && ("float".equals(t1) || esArray1)) {
            der = new ConversionFloat(e2);
            tipoFinal = "float";
        } else if ("float".equals(t1) || "float".equals(t2) || esArray1 || esArray2) {
            tipoFinal = "float";
        }

        return new OpResult(izq, der, tipoFinal);
    }
:};


parser code {:

    public static SymbolTable tablaSimbolos = new SymbolTable();

    // public ValidatorDataType validador = new ValidatorDataType();

    public static ArrayList<Declaracion> declaracionesMacro = new ArrayList<>();

    public void syntax_error(Symbol s){
        System.out.println("Error en la linea "+ (s.left+1)+ " Columna "+ s.right+ ". Valor simbolo '"
        +s.value+"' . Simbolo n° "+s.sym+ " no reconocido." );
    }

    public void unrecovered_syntax_error(Symbol s) throws java.lang.Exception{
        System.out.println("Error en la linea "+ (s.left+1)+ " Columna "+ s.right+ ". Valor simbolo '"
        +s.value+"' . Simbolo n° "+s.sym+ " no reconocido." );
    }
:};

/* -------- TERMINALES -------- */
terminal String ID;
terminal String ENTERO;
terminal String FLOAT;
terminal String FLOAT_ARRAY;
terminal String BOOLEAN;
terminal String STRING;
terminal String DOS_PUNTOS;
terminal String COMA;
terminal UMINUS;

terminal TYPE_INT;
terminal TYPE_FLOAT;
terminal TYPE_BOOL;
terminal TYPE_ARRAY;

terminal PROGRAM;
terminal IF, ELSE, ELIF;
terminal WHILE, ALT_WHILE;
//terminal BEGIN, END;
terminal PRINT, BREAK, CONTINUE;

terminal String VALOR_MAS_CERCANO;

terminal OP_SUMA, OP_RESTA, OP_MULTI, OP_DIV;
terminal AND, OR, NOT;
terminal IGUAL, IGUALDAD;
terminal MAYOR, MENOR, MAYORIGUAL, MENORIGUAL;
terminal PAREN_A, PAREN_C;
terminal CORCH_A, CORCH_C;
terminal INDENT, DEDENT;

terminal DESIGUAL;

terminal READ_INT;
terminal READ_FLOAT;
terminal READ_BOOL;

/* -------- NO TERMINALES -------- */
non terminal Programa programa;
non terminal ArrayList<Sentencia> lista_sentencias;
non terminal Sentencia sentencia;
non terminal ArrayList<Sentencia> bloque;
non terminal ArrayList<Declaracion> lista_variables;
non terminal ArrayList<Declaracion> lista_de_lineas;
non terminal Declaracion variable;
non terminal ArrayList<String> lista_de_variable;
non terminal String tipo_datos;

non terminal Sentencia sentencia_if;
non terminal ArrayList<Sentencia> sentencia_elif;
non terminal Sentencia sentencia_while;
non terminal SentenciaAlt sentencia_alt;
non terminal inicio_loop;

non terminal Expresion expr_logica;
non terminal Expresion expr_and;
non terminal Expresion expr_not;
non terminal Expresion expr_relacional;
non terminal Expresion expr_arit;
non terminal Expresion termino;
non terminal Expresion factor;
non terminal Sentencia asignacion;

/* -------- PRECEDENCIA -------- (MAS ABAJO ES MAS PROIRIDAD MAS ARRIBA ES MENOS)*/

precedence right UMINUS;
/* -------- START -------- */
start with programa;

/* -------- GRAMÁTICA -------- */

programa ::= lista_variables:v PROGRAM bloque:l {:
    System.out.println("REGLA 0.1: programa -> PROGRAM lista_sentencias");
    System.out.printf("REGLA 0.1: programa -> %s%n%n", l);
    if (v == null) {
            v = new ArrayList<Declaracion>();
        }
    RESULT = new Programa("MiProyecto", v, declaracionesMacro, l);

:}
| lista_variables:v PROGRAM{:
    RESULT = new Programa("MiProyecto", v, declaracionesMacro, null);
:};


lista_variables ::= lista_de_lineas:l {:
    System.out.println("REGLA 16: lista_variables -> lista_de_lineas");
    RESULT = l;
:}
| /* vacío */ {:
    System.out.println("REGLA 17: lista_variables -> vacio");
    RESULT = new ArrayList<Declaracion>();
:};

lista_de_lineas ::= lista_de_lineas:l variable:v {:
    System.out.println("REGLA 18: lista_de_lineas -> lista_de_lineas variable");
    l.add(v); // Agrega la nueva declaración a la lista
    RESULT = l;
:}
| variable:v {:
    System.out.println("REGLA 19: lista_de_lineas -> variable");
    ArrayList<Declaracion> lista = new ArrayList<>();
    lista.add(v);
    RESULT = lista;
:};

variable ::= tipo_datos:t DOS_PUNTOS lista_de_variable:nombres {:
System.out.println("REGLA 20: variable -> tipo_datos DOS_PUNTOS lista_de_variable");
for (String id : nombres) {
        if (tablaSimbolos.exists(id)) {
            System.err.println("Error: Variable '" + id + "' ya declarada.");
        } else {
            tablaSimbolos.add("ID", id, t, null, null);
            System.out.println("Declarado: " + id + " de tipo " + t);
        }
    }
    RESULT = new Declaracion(t, nombres);
:}
| TYPE_ARRAY CORCH_A ENTERO:e CORCH_C DOS_PUNTOS lista_de_variable:nombres{:
System.out.println("REGLA 15: Creacion de array");
String tipoEspecial = "FLOAT_ARRAY";
    for (String id : nombres) {
        if (tablaSimbolos.exists(id)) {
            System.err.println("Error: Variable '" + id + "' ya declarada.");
        } else {
            tablaSimbolos.add("ID", id, tipoEspecial, null, String.valueOf(e));
            System.out.println("Declarado: " + id + " de tipo " + tipoEspecial);
        }
    }
    RESULT = new DeclaracionArray(e, nombres);
:};



lista_de_variable ::= lista_de_variable:list COMA ID:e {:
      list.add(e);
      RESULT = list;
:}
| ID:n{:
        ArrayList<String> lista = new ArrayList<>();
        lista.add(n);
        RESULT = lista;
:};

tipo_datos ::= TYPE_INT{: RESULT = "INT";  :}
| TYPE_FLOAT  {: RESULT = "FLOAT";   :}
| TYPE_BOOL   {: RESULT = "BOOLEAN"; :};

lista_sentencias ::= lista_sentencias:l sentencia:s {:
    System.out.println("REGLA 1.1: lista_sentencias -> lista_sentencias sentencia");
    System.out.printf("REGLA 1.1: lista_sentencias -> %s %s%n%n", l, s);
    l.add(s);
    RESULT = l;
:}
| {:
      RESULT = new ArrayList<Sentencia>();
  :} ;

bloque ::= INDENT lista_sentencias:l DEDENT {:
    System.out.println("REGLA 8: bloque -> INDENT lista_sentencias DEDENT");
    System.out.printf("REGLA 8: bloque -> %s%n%n", l);
    RESULT = l;
:};

sentencia ::= sentencia_if:s {:
    System.out.println("REGLA 3.1: sentencia -> sentencia_if");
    System.out.printf("REGLA 3.1: sentencia -> %s%n%n", s);
    RESULT = s;
:}
| sentencia_while:s {:
    System.out.println("REGLA 3.2: sentencia -> sentencia_while");
    System.out.printf("REGLA 3.2: sentencia -> %s%n%n", s);
    RESULT = s;
:}
| asignacion:s {:
    System.out.println("REGLA 3.3: sentencia -> asignacion");
    System.out.printf("REGLA 3.3: sentencia -> %s%n%n", s);
    RESULT = s;
:}
| PRINT PAREN_A expr_logica:e PAREN_C {:
    System.out.println("REGLA 3.4: sentencia -> PRINT expresion");
    System.out.printf("REGLA 3.4: sentencia -> %s%n%n", e);

    String tipo = e.getTipo();
    String tipoLLVM = "";
    tam = "0"; // Crucial: Resetear para evitar arrastrar tamaños de prints anteriores

    if ("i32".equals(tipo)) {
        tipoLLVM = "i32";
    } else if ("float".equals(tipo) || "double".equals(tipo)) {
        tipoLLVM = "double"; // printf en LLVM suele requerir promotion a double para flotantes
    } else if ("i1".equals(tipo)) {
        tipoLLVM = "i1";
    } else if (tipo != null && tipo.matches("\\d+")) { // Si el tipo es un número, es un array (su tamaño)
        tipoLLVM = "array";
        tam = tipo; // Asignamos el tamaño extraído directamente del tipo del nodo
    }

    RESULT = new SentenciaPrint(e, tipoLLVM, tam);
:}
| PRINT PAREN_A STRING:str PAREN_C
{:
           if (!tablaSimbolos.exists(str)) {
               String texto;
               // Pasamos null en el ID para que tu método add() genere la llave "_contenido"
               texto = str.replace("\n", " ");
               texto = texto.replace("\r", "");
               tablaSimbolos.add("CTE_STR", null, "STRING", texto, null);
               System.out.println("REGLA: PRINT -> Nueva cadena guardada: " + str);
           } else {
               System.out.println("REGLA: PRINT -> La cadena ya existe en la tabla: " + str);
           }
           RESULT = RESULT = new SentenciaPrint(new StringLiteral(str), "i8");;
:}
| BREAK {:
    System.out.println("REGLA 3.5: sentencia -> BREAK");
    System.out.printf("REGLA 3.5: sentencia -> break%n%n");
    if (nivelLoop == 0) {
        throw new RuntimeException("ERROR SEMÁNTICO: BREAK fuera de un ciclo.");
    }
    System.out.println("BREAK válido, nivelLoop = " + nivelLoop);
    RESULT = new SentenciaBreak();
:}
| CONTINUE {:
    System.out.println("REGLA 3.6: sentencia -> CONTINUE");
    System.out.printf("REGLA 3.6: sentencia -> continue%n%n");
    if (nivelLoop == 0) {
        throw new RuntimeException("ERROR SEMÁNTICO: CONTINUE fuera de un ciclo.");
    }
    RESULT = new SentenciaContinue();
:};

asignacion::= ID:id IGUAL expr_logica:e {:
    System.out.println("REGLA 15.1: sentencia -> ID = expresion");

    // Obtener tipo destino normalizado
    String tDest = tablaSimbolos.getTipo(id);
    if ("FLOAT_ARRAY".equals(tDest)) {
        tDest = tablaSimbolos.getTamano(id);
    } else if ("INT".equals(tDest)) tDest = "i32";
    else if ("FLOAT".equals(tDest)) tDest = "float";
    else if ("BOOLEAN".equals(tDest)) tDest = "i1";

    String tExp = e.getTipo();
    boolean esArrayDest = tDest.matches("\\d+");
    boolean esArrayExp = tExp.matches("\\d+");

    if (esArrayDest) {
        if (esArrayExp && !tDest.equals(tExp)) {
            throw new RuntimeException("ERROR SEMÁNTICO: Dimensiones incompatibles en asignación de arreglos.");
        }
        if (!esArrayExp && "i1".equals(tExp)) {
            throw new RuntimeException("ERROR SEMÁNTICO: No se puede hacer broadcasting de un BOOLEAN a un FLOAT_ARRAY.");
        }
    } else {
        if (esArrayExp) {
            throw new RuntimeException("ERROR SEMÁNTICO: No se puede asignar un arreglo a la variable escalar '" + id + "'.");
        }
        if ("i1".equals(tDest) && !"i1".equals(tExp)) {
            throw new RuntimeException("ERROR SEMÁNTICO: Tipos incompatibles para variable BOOLEAN '" + id + "'.");
        }
    }

    // Coerción en asignación escalar
    Expresion exprFinal = e;
    if ("float".equals(tDest) && "i32".equals(tExp)) {
        exprFinal = new ConversionFloat(e);
    }

    RESULT = new Asignacion(id, exprFinal, tablaSimbolos, tDest);
:}
| ID:i CORCH_A expr_arit:exp CORCH_C IGUAL expr_logica:ex {:
    System.out.println("REGLA 15.2: Asignacion ARRAY celdas");

    if (!"i32".equals(exp.getTipo())) {
        throw new RuntimeException("ERROR SEMÁNTICO: El índice del arreglo '" + i + "' debe ser tipo INT.");
    }
    if (!"FLOAT_ARRAY".equals(tablaSimbolos.getTipo(i))) {
        throw new RuntimeException("ERROR SEMÁNTICO: '" + i + "' no es un arreglo.");
    }
    if ("i1".equals(ex.getTipo())) {
        throw new RuntimeException("ERROR SEMÁNTICO: Tipo BOOLEAN incompatible para celda FLOAT.");
    }

    Expresion valFinal = ex;
    if ("i32".equals(ex.getTipo())) {
        valFinal = new ConversionFloat(ex);
    }

    RESULT = new AsignacionArray(i, exp, valFinal, tablaSimbolos.getTamano(i));
:}
;

/* -------- IF -------- */

sentencia_if ::= IF expr_logica:e bloque:b sentencia_elif:s_elif
{:
    System.out.println("REGLA 4: sentencia_if -> IF expresion bloque sentencia_elif");
    System.out.printf("REGLA 4: if %s then %s %s%n%n", e, b, s_elif);
    RESULT = new SentenciaIf(e, b, s_elif);
:};

/* -------- ELIF / ELSE -------- */

sentencia_elif ::= ELIF expr_logica:e bloque:b sentencia_elif:s
{:
    System.out.println("REGLA 5.1: sentencia_elif -> ELIF expresion bloque sentencia_elif");
    System.out.printf("REGLA 5.1: elif %s then %s %s%n%n", e, b, s);
    // Creamos una lista que contendrá el bloque del ELIF transformado en un IF
        ArrayList<Sentencia> listaElif = new ArrayList<>();

        // El ELIF se convierte en un objeto SentenciaIf
        // (el cual a su vez recibe la lista 's' para sus propios elses)
        SentenciaIf nodoElif = new SentenciaIf(e, b, s);

        listaElif.add(nodoElif);
        RESULT = listaElif;
:}
| ELSE bloque:b
{:
    System.out.println("REGLA 5.2: sentencia_elif -> ELSE bloque");
    System.out.printf("REGLA 5.2: else %s%n%n", b);
    RESULT = b;
:}
| /* VACÍO */
{:
    System.out.println("REGLA 5.3: sentencia_elif -> epsilon");
    RESULT = null;
:};

/* marcador que se reduce ANTES de parsear el bloque */
inicio_loop ::= /* vacío */
{:
    nivelLoop++;
    System.out.println("Entrando a loop, nivelLoop = " + nivelLoop);
:};

sentencia_while ::=WHILE inicio_loop expr_logica:e bloque:b sentencia_alt:alt   //La acción {: nivelLoop++; :} después del terminal WHILE se ejecuta en el momento exacto en que se reconoce la palabra WHILE, antes de parsear el cuerpo del loop.
{:
    System.out.println("REGLA 6: sentencia_while -> WHILE expresion bloque");
    System.out.printf("REGLA 6: while %s do %s%n%n", e, b);
    nivelLoop--;                              // ← decrementar al salir
    RESULT = new SentenciaWhile(e, b, alt);
:};

sentencia_alt ::= ALT_WHILE expr_logica:e bloque:b sentencia_alt:resto
{:
    System.out.println("REGLA 7: sentencia_alt -> ALT_WHILE expresion bloque");
    System.out.printf("REGLA 7: alt_while %s do %s%n%n", e, b);
    RESULT = new SentenciaAlt(e, b, resto);
:}
| {:
      RESULT = null;
:};

/* -------- EXPRESIONES -------- */


expr_logica ::= expr_and:e1 OR expr_logica:e2 {:
    System.out.println("REGLA 10.1: expr_logica -> expr_and OR expr_logica");

    // Como e1 ya tiene su tipo LLVM adentro ("i32", "float", "i1"),
    // se lo pasás directamente al constructor. ¡En una sola línea!
    RESULT = new OperacionOr(e1, e2, e1.getTipo());
:}
| expr_and:e {:
    RESULT = e;
:};

expr_and ::= expr_not:e1 AND expr_and:e2 {:
    System.out.println("REGLA 10.2: expr_and -> expr_not AND expr_and");

    // Lo mismo para el AND: tomás el tipo LLVM de e1 directamente
    RESULT = new OperacionAnd(e1, e2, e1.getTipo());
:}
| expr_not:e {:
    RESULT = e;
:};

expr_not    ::= NOT expr_not:e {:
    System.out.println("REGLA 10.3: expr_logica -> NOT expr_relacional");
    System.out.printf("REGLA 10.3: expr_logica -> NOT %s%n%n", e);
    RESULT = new NotLogico(e);
:}
| expr_relacional:e {:
    System.out.println("REGLA 10.4: expr_logica -> expr_relacional");
    System.out.printf("REGLA 10.4: expr_logica -> %s%n%n", e);
    RESULT = e;
:};

expr_relacional ::= expr_arit:e1 IGUALDAD expr_arit:e2 {:
    OpResult res = verificarRelacional(e1, e2);
    RESULT = new Igualdad(res.izq, res.der, res.tipoLLVM);
:}
| expr_arit:e1 MAYOR expr_arit:e2 {:
    OpResult res = verificarRelacional(e1, e2);
    RESULT = new Mayor(res.izq, res.der, res.tipoLLVM);
:}
| expr_arit:e1 MENOR expr_arit:e2 {:
    OpResult res = verificarRelacional(e1, e2);
    RESULT = new Menor(res.izq, res.der, res.tipoLLVM);
:}
| expr_arit:e1 MAYORIGUAL expr_arit:e2 {:
    OpResult res = verificarRelacional(e1, e2);
    RESULT = new MayorIgual(res.izq, res.der, res.tipoLLVM);
:}
| expr_arit:e1 MENORIGUAL expr_arit:e2 {:
    OpResult res = verificarRelacional(e1, e2);
    RESULT = new MenorIgual(res.izq, res.der, res.tipoLLVM);
:}
| expr_arit:e1 DESIGUAL expr_arit:e2 {:
    OpResult res = verificarRelacional(e1, e2);
    RESULT = new Desigual(res.izq, res.der, res.tipoLLVM);
:}
| expr_arit:e {:
    RESULT = e;
:};

expr_arit ::= expr_arit:e1 OP_SUMA termino:e2 {:
    OpResult res = verificarYCoercer(e1, e2);
    RESULT = new Suma(res.izq, res.der, res.tipoLLVM);
:}
| expr_arit:e1 OP_RESTA termino:e2 {:
    OpResult res = verificarYCoercer(e1, e2);
    RESULT = new Resta(res.izq, res.der, res.tipoLLVM);
:}
| termino:e {:
    RESULT = e;
:};

termino ::= termino:e1 OP_MULTI factor:e2 {:
    OpResult res = verificarYCoercer(e1, e2);
    RESULT = new Multiplicacion(res.izq, res.der, res.tipoLLVM);
:}
| termino:e1 OP_DIV factor:e2 {:
    OpResult res = verificarYCoercer(e1, e2);
    RESULT = new Division(res.izq, res.der, res.tipoLLVM);
:}
| factor:e {:
    RESULT = e;
:};

factor ::= ENTERO:e {:
    System.out.println("REGLA 14.1: factor -> ENTERO");
    System.out.printf("REGLA 14.1: factor -> %s%n%n", e);
    RESULT = new IntLiteral(e);
:}
| FLOAT:e {:
    System.out.println("REGLA 14.2: factor -> FLOAT");
    System.out.printf("REGLA 14.2: factor -> %s%n%n", e);
    RESULT = new FloatLiteral(e);
:}
| BOOLEAN:e {:
    System.out.println("REGLA 14.3: factor -> BOOLEAN");
    System.out.printf("REGLA 14.3: factor -> %s%n%n", e);
    RESULT = new BoolLiteral(e);
:}
| ID:e {:
      System.out.println("REGLA 14.4: factor -> ID");
      if (!tablaSimbolos.exists(e)) {
                throw new RuntimeException("ERROR SEMÁNTICO: La variable '" + e + "' no ha sido declarada.");
            }
      String t = tablaSimbolos.getTipo(e);
      String tipoLLVM = "";

      if ("INT".equals(t)) {
          tipoLLVM = "i32";
      } else if ("FLOAT".equals(t)) {
          tipoLLVM = "float";
      } else if ("BOOLEAN".equals(t)) {
          tipoLLVM = "i1";
      } else if ("FLOAT_ARRAY".equals(t)) {
          tipoLLVM = tablaSimbolos.getTamano(e); //  Pasamos la dimensión ("10", "50", etc.) directamente
      }

      RESULT = new IdLiteral(e, tipoLLVM);
  :}
| ID:i CORCH_A expr_arit:exp CORCH_C {:
    System.out.println("REGLA 14.8: factor -> ARRAY[" + exp + "]");
    RESULT = new AccesoArray(i, exp, tablaSimbolos.getTamano(i));
:}
| FLOAT_ARRAY:e {:
    System.out.println("REGLA 14.5: factor -> FLOAT_ARRAY");
    System.out.printf("REGLA 14.5: factor -> %s%n%n", e);
    RESULT = new ArrayLiteral(e);
:}
|READ_INT
{:
    System.out.println("REGLA 14.5: factor -> READ_INT()");
    RESULT = new ReadInt();
:}
|READ_FLOAT
{:
    System.out.println("REGLA 14.5: factor -> READ_FLOAT()");
    RESULT = new ReadFloat();
:}
|READ_BOOL
{:
    System.out.println("REGLA 14.5: factor -> READ_FLOAT()");
    RESULT = new ReadBoolean();
:}
| PAREN_A expr_logica:e PAREN_C {:
    System.out.println("REGLA 14.6: factor -> PAREN_A expresion PAREN_C");
    System.out.printf("REGLA 14.6: factor -> (%s)%n%n", e);
    RESULT = e;
:}
| VALOR_MAS_CERCANO PAREN_A expr_arit:ref COMA FLOAT_ARRAY:listaId PAREN_C
{:
    System.out.println("=== REGLA: Macro 'VALOR_MAS_CERCANO' (Estructura Semántica AST Corregida) ===");

    // =========================================================================
    // 0. GENERACIÓN DE IDENTIFICADORES ÚNICOS LIMPIOS
    // =========================================================================
    String sufijoUnico = String.valueOf(Math.abs(listaId.hashCode()));

    String nombreArreglo = "arr_literal_" + sufijoUnico;
    int dimension = listaId.replace("[", "").replace("]", "").split(",").length;
    String dimArreglo = String.valueOf(dimension);

    String varMasCercano = "mc_masCercano_" + sufijoUnico;
    String varDistMin    = "mc_distMin_"    + sufijoUnico; // difMin
    String varI          = "mc_i_"          + sufijoUnico;
    String varDistActual = "mc_distActual_" + sufijoUnico; // dif

    // =========================================================================
    // 1. ENTORNO SEMÁNTICO LOCAL (Sin varActual para evitar aristas duplicadas)
    // =========================================================================
    parser.SymbolTable tablaLocal = new parser.SymbolTable();

    tablaLocal.add("ID", nombreArreglo, "float", dimArreglo, dimArreglo);
    tablaLocal.add("ID", varMasCercano, "float", "-", "-");
    tablaLocal.add("ID", varDistMin,    "float", "-", "-");
    tablaLocal.add("ID", varI,          "i32",   "-", "-");
    tablaLocal.add("ID", varDistActual, "float", "-", "-");

    tablaSimbolos.add("ID", nombreArreglo, "float", dimArreglo, dimArreglo);
    tablaSimbolos.add("ID", varMasCercano, "float", "-", "-");
    tablaSimbolos.add("ID", varDistMin,    "float", "-", "-");
    tablaSimbolos.add("ID", varI,          "i32",   "-", "-");
    tablaSimbolos.add("ID", varDistActual, "float", "-", "-");

    // =========================================================================
    // 2. REGISTRO EN LA LISTA GLOBAL DE DECLARACIONES DE MACROS
    // =========================================================================
    ArrayList<Declaracion> declaracionesLocales = new ArrayList<>();

    // A. Declaración del Arreglo Literal Anónimo
    ArrayList<String> varArreglo = new ArrayList<>();
    varArreglo.add(nombreArreglo);
    DeclaracionArray declArr = new DeclaracionArray(dimArreglo, varArreglo);
    parser.declaracionesMacro.add(declArr);
    declaracionesLocales.add(declArr);

    // B. Declaración de Variables Floats Internas
    ArrayList<String> varsFloat = new ArrayList<>();
    varsFloat.add(varMasCercano); varsFloat.add(varDistMin); varsFloat.add(varDistActual);
    Declaracion declFloats = new Declaracion("float", varsFloat);
    parser.declaracionesMacro.add(declFloats);
    declaracionesLocales.add(declFloats);

    // C. Declaración del Índice del Bucle
    ArrayList<String> varsInt = new ArrayList<>();
    varsInt.add(varI);
    Declaracion declInt = new Declaracion("i32", varsInt);
    parser.declaracionesMacro.add(declInt);
    declaracionesLocales.add(declInt);

    // LISTA DE PASOS DE EJECUCIÓN LÓGICA (Nodos secuenciales del AST)
    ArrayList<Sentencia> pasos = new ArrayList<>();

    // =========================================================================
    // 3. POBLADO INICIAL DEL ARREGLO
    // =========================================================================
    String[] valoresArreglo = listaId.replace("[", "").replace("]", "").split(",");

    for (int k = 0; k < valoresArreglo.length; k++) {
        String elementoLimpio = valoresArreglo[k].trim();
        if (!elementoLimpio.isEmpty()) {
            pasos.add(new AsignacionArray(
                nombreArreglo,
                new IntLiteral(String.valueOf(k)),
                new FloatLiteral(elementoLimpio),
                dimArreglo
            ));
        }
    }

    // =========================================================================
    // 4. DETECCIÓN DINÁMICA DE TIPO PARA 'ref' (Tu nuevo esquema de validación)
    // =========================================================================
    String tipoRef = ref.getTipo();
    Expresion refConvertida = ref;
    if ("INT".equals(tipoRef) || "i32".equals(tipoRef)) {
        refConvertida = new ConversionFloat(ref);
    }

    // =========================================================================
    // 5. CONSTRUCCIÓN DEL SUBÁRBOL SEGÚN TU PSEUDOCÓDIGO OBJETIVO
    // =========================================================================

    // --- 5.1. masCercano ← ARR[0] ---
    Expresion arr0 = new AccesoArray(nombreArreglo, new IntLiteral("0"), dimArreglo);
    pasos.add(new Asignacion(varMasCercano, arr0, tablaLocal, "float"));

    // --- 5.2. IF ARR[0] - V >= 0 THEN difMin ← ARR[0] - V ELSE difMin ← V - ARR[0] ---
    ArrayList<Sentencia> thenInicial = new ArrayList<>();
    thenInicial.add(new Asignacion(varDistMin, new Resta(new AccesoArray(nombreArreglo, new IntLiteral("0"), dimArreglo), refConvertida, "float"), tablaLocal, "float"));

    ArrayList<Sentencia> elseInicial = new ArrayList<>();
    elseInicial.add(new Asignacion(varDistMin, new Resta(refConvertida, new AccesoArray(nombreArreglo, new IntLiteral("0"), dimArreglo), "float"), tablaLocal, "float"));

    // Equivalencia lógica usando Menor: Si (ARR[0] - V < 0) es TRUE, va al ELSE del pseudocódigo, si es FALSE va al THEN.
    Expresion condInicial = new Menor(new Resta(new AccesoArray(nombreArreglo, new IntLiteral("0"), dimArreglo), refConvertida, "float"), new FloatLiteral("0.0"), "float");
    pasos.add(new SentenciaIf(condInicial, elseInicial, thenInicial));

    // --- 5.3. i ← 1 ---
    pasos.add(new Asignacion(varI, new IntLiteral("1"), tablaLocal, "i32"));

    // --- 5.4. CUERPO DEL BUCLE WHILE ---
    ArrayList<Sentencia> cuerpoWhile = new ArrayList<>();

    // IF ARR[i] - V >= 0 THEN dif ← ARR[i] - V ELSE dif ← V - ARR[i]
    ArrayList<Sentencia> thenWhile = new ArrayList<>();
    thenWhile.add(new Asignacion(varDistActual, new Resta(new AccesoArray(nombreArreglo, new IdLiteral(varI, "i32"), dimArreglo), refConvertida, "float"), tablaLocal, "float"));

    ArrayList<Sentencia> elseWhile = new ArrayList<>();
    elseWhile.add(new Asignacion(varDistActual, new Resta(refConvertida, new AccesoArray(nombreArreglo, new IdLiteral(varI, "i32"), dimArreglo), "float"), tablaLocal, "float"));

    Expresion condWhileIf = new Menor(new Resta(new AccesoArray(nombreArreglo, new IdLiteral(varI, "i32"), dimArreglo), refConvertida, "float"), new FloatLiteral("0.0"), "float");
    cuerpoWhile.add(new SentenciaIf(condWhileIf, elseWhile, thenWhile));

    // IF dif < difMin THEN difMin ← dif; masCercano ← ARR[i];
    ArrayList<Sentencia> cuerpoComparacionIf = new ArrayList<>();
    cuerpoComparacionIf.add(new Asignacion(varDistMin, new IdLiteral(varDistActual, "float"), tablaLocal, "float"));
    cuerpoComparacionIf.add(new Asignacion(varMasCercano, new AccesoArray(nombreArreglo, new IdLiteral(varI, "i32"), dimArreglo), tablaLocal, "float"));

    Expresion condicionComparacion = new Menor(new IdLiteral(varDistActual, "float"), new IdLiteral(varDistMin, "float"), "float");
    cuerpoWhile.add(new SentenciaIf(condicionComparacion, cuerpoComparacionIf, null));

    // i ← i + 1
    Expresion incrementoI = new Suma(new IdLiteral(varI, "i32"), new IntLiteral("1"), "i32");
    cuerpoWhile.add(new Asignacion(varI, incrementoI, tablaLocal, "i32"));

    // --- 5.5. CONTROL DEL WHILE DO: while (i < N) ---
    Expresion condicionWhile = new Menor(new IdLiteral(varI, "i32"), new IntLiteral(dimArreglo), "i32");
    pasos.add(new SentenciaWhile(condicionWhile, cuerpoWhile, null));

    // Retornamos el nodo empaquetado final listo para ser recorrido por tu graficador en orden estricto
    RESULT = new ValorMasCercano(refConvertida, nombreArreglo, declaracionesLocales, pasos, varMasCercano);
:}
| OP_RESTA factor:y {:
    System.out.println("REGLA 14.7: factor -> - factor (unario)");
    System.out.printf("REGLA 14.7: factor -> -%s%n%n", y);
    RESULT = new MenosUnario(y, tablaSimbolos);
:}%prec UMINUS;



